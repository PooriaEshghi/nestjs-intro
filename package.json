{
  "name": "nestjs-intro",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "set TS_NODE_TRANSPILE_ONLY=1&& set CHOKIDAR_USEPOLLING=1&& set CHOKIDAR_INTERVAL=300&& nest start --watch",
    "start:debug": "set NODE_OPTIONS=--inspect&& set CHOKIDAR_USEPOLLING=1&& set CHOKIDAR_INTERVAL=300&& nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:verbose": "jest --verbose",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "doc": "npx @compodoc/compodoc -p tsconfig.json -s --port 3001 --watch -d ./documentation",
    "pm2:start": "pm2 start npm --name nest-blog -- run start:prod"
  },
  "dependencies": {
    "@compodoc/compodoc": "^2.0.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/typeorm": "^11.0.3",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ejs": "^3.1.10",
    "joi": "^18.2.9",
    "pg": "^8.11.5",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^4.17.17",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^30.5.2",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@isaacs/brace-expansion": "5.0.1",
    "baseline-browser-mapping": "2.11.27",
    "body-parser@^1": "1.20.8",
    "body-parser@^2": "2.3.0",
    "brace-expansion@^1": "1.1.21",
    "brace-expansion@^2": "2.1.7",
    "browserslist": "4.29.3",
    "fast-uri": "3.1.8",
    "flatted": "3.4.4",
    "form-data@^4": "4.0.6",
    "glob@^10": "10.5.0",
    "glob@^11": "11.1.0",
    "handlebars": "4.7.10",
    "js-cookie": "3.0.8",
    "js-yaml@^4": "4.3.2",
    "js-yaml@^5": "5.4.3",
    "minimatch@^9": "9.0.9",
    "jws@^3": "3.2.3",
    "jws@^4": "4.0.1",
    "liquidjs": "10.30.0",
    "lodash": "4.18.1",
    "multer": "2.4.0",
    "path-to-regexp@^0.1": "0.1.13",
    "picomatch@^2": "2.3.2",
    "picomatch@^4": "4.0.7",
    "proxy-addr": "2.0.8",
    "qs": "6.16.0",
    "serialize-javascript": "7.1.2",
    "tar": "7.5.22",
    "tmp": "0.2.7",
    "undici": "7.30.0",
    "validator": "13.15.35",
    "webpack": "5.111.1",
    "websocket-driver": "0.7.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "./",
    "modulePaths": [
      "<rootDir>"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
